{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"paths": {
			"$houdini": ["./.houdini/index.ts"],
			"$houdini/*": ["./.houdini/*"]
		},
		"sourceMap": true,
		"strict": true,
		"rootDirs": [".", "./.svelte-kit/types", "./.houdini/types"],
		"types": ["vitest/globals", "$app/types"]
	},
	"include": ["src"]
}
