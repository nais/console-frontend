{
	"name": "@nais/ui",
	"version": "0.1.0",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nais/console-frontend.git",
		"directory": "packages/ui"
	},
	"publishConfig": {
		"registry": "https://europe-north1-npm.pkg.dev/nais-io/nais-public-npm/",
		"access": "public"
	},
	"files": [
		"dist"
	],
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./tokens.css": "./dist/tokens.css",
		"./theme.css": "./dist/theme.css"
	},
	"scripts": {
		"build": "svelte-package",
		"prepack": "pnpm run build",
		"check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
	},
	"peerDependencies": {
		"svelte": "^5.57.3"
	},
	"dependencies": {
		"@lucide/svelte": "1.63.0",
		"bits-ui": "2.20.2"
	},
	"devDependencies": {
		"@sveltejs/package": "3.0.2",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.7",
		"typescript": "6.0.3",
		"vite": "8.3.5"
	}
}
