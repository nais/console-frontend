{
	"name": "console-frontend",
	"version": "0.0.1",
	"private": true,
	"packageManager": "pnpm@11.22.0",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"build": "pnpm --filter @nais/ui build && vite build",
		"check-outdated": "pnpm outdated",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"check": "pnpm --filter @nais/ui build && pnpm --filter @nais/ui check && pnpm exec houdini generate && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"dev-live-share": "pnpm --filter @nais/ui build && vite dev --host ::",
		"dev": "pnpm --filter @nais/ui build && vite dev",
		"eslint": "eslint .",
		"format": "prettier --write .",
		"lint-staged": "lint-staged",
		"lint": "prettier --check . && eslint .",
		"prepare": "svelte-kit sync",
		"preview": "vite preview",
		"test": "vitest",
		"test:browser": "pnpm --filter @nais/ui build && playwright test",
		"test:package": "node scripts/check-ui-package.mjs",
		"changeset": "changeset",
		"release:version": "changeset version && pnpm install --lockfile-only --ignore-scripts && prettier --write packages/ui/package.json packages/ui/CHANGELOG.md pnpm-lock.yaml",
		"release:ui": "pnpm --filter @nais/ui build && changeset publish",
		"update-outdated": "pnpm update --latest"
	},
	"devDependencies": {
		"@changesets/cli": "3.0.3",
		"@eslint/compat": "2.1.1",
		"@eslint/js": "10.0.1",
		"@lucide/svelte": "1.72.0",
		"@playwright/test": "1.65.0",
		"@sveltejs/adapter-node": "5.5.8",
		"@sveltejs/kit": "2.70.4",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.5",
		"@types/d3-array": "3.2.2",
		"@types/d3-time": "3.0.4",
		"@types/jsdom": "30.0.0",
		"@types/sortablejs": "1.15.9",
		"bits-ui": "2.21.0",
		"date-fns": "4.4.0",
		"esbuild": "0.28.2",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.24.1",
		"eslint-plugin-unicorn": "79.0.0",
		"globals": "17.14.0",
		"houdini": "2.0.13",
		"houdini-svelte": "3.0.7",
		"husky": "9.1.7",
		"jsdom": "30.1.3",
		"lint-staged": "17.6.0",
		"pino-pretty": "13.2.0",
		"prettier": "3.10.0",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"svelte": "5.59.1",
		"svelte-check": "4.7.8",
		"tailwindcss": "4.3.5",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.2",
		"vite": "8.3.8",
		"vitest": "5.1.0"
	},
	"type": "module",
	"dependencies": {
		"@codemirror/language": "6.13.1",
		"@codemirror/state": "6.7.6",
		"@codemirror/theme-one-dark": "6.1.3",
		"@codemirror/view": "6.43.15",
		"@layerstack/utils": "2.0.0-next.19",
		"@nais/ui": "workspace:*",
		"@prometheus-io/codemirror-promql": "0.316.0",
		"@slack/types": "3.3.0",
		"@slack/web-api": "8.3.0",
		"cron-parser": "5.10.4",
		"cronstrue": "3.39.0",
		"d3-array": "3.2.5",
		"d3-time": "3.1.1",
		"graphql": "17.1.0",
		"graphql-sse": "2.6.3",
		"layerchart": "2.10.0",
		"pino": "10.4.0",
		"pretty-bytes": "7.2.0",
		"sortablejs": "1.15.7",
		"svelte-highlight": "7.23.1",
		"yaml": "2.9.1"
	},
	"lint-staged": {
		"*.{js,ts,svelte,gql,css,md,json}": "prettier --write",
		"*.{js,ts,svelte,gql}": "eslint --fix"
	},
	"graphql": {
		"schema": "https://localhost:3000/graphql",
		"documents": "**/*.{graphql,js,ts,jsx,tsx,svelte}"
	}
}
